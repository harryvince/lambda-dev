{
  "name": "aws-lambda-dev",
  "version": "1.0.1",
  "description": "Hot-reload, deploy, and invoke existing AWS Lambda functions from a YAML-configured local workflow.",
  "bin": {
    "aws-lambda-dev": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "check": "bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist .lambda-dev lambda-dev-*.tgz aws-lambda-dev-*.tgz",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1076.0",
    "@aws-sdk/credential-providers": "3.1076.0",
    "adm-zip": "0.5.18",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "esbuild": "0.28.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
