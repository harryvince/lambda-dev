{
  "name": "aws-lambda-dev",
  "version": "2.5.0",
  "description": "Hot-reload, deploy, and invoke existing AWS Lambda functions from a YAML-configured local workflow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryvince/lambda-dev.git"
  },
  "bin": {
    "aws-lambda-dev": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist .lambda-dev lambda-dev-*.tgz aws-lambda-dev-*.tgz",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1152.0",
    "adm-zip": "0.6.1",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/adm-zip": "0.6.0",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.20.0 || >=24.8.0"
  },
  "packageManager": "bun@1.4.3"
}
